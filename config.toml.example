# Copy this file to config.toml beside the driichi executable.
# The config file's parent is the runtime data root.
bind = "127.0.0.1:3000"
public_origin = "http://127.0.0.1:3000"
# Raw OpenAPI YAML is Admin-only and disabled unless explicitly enabled.
api_docs = false
# Request logs are allowlisted and secret-safe; text is the default.
tracing_format = "text"
unlimited_watchdog_seconds = 300
mcp_session_idle_seconds = 1800
empty_room_cleanup_seconds = 3600
shutdown_seconds = 10

# The localhost HTTP public_origin above cannot enable a live ChatGPT gateway.
# Use a stable, publicly reachable HTTPS origin before setting enabled = true.
# Keep DRIICHI_CHATGPT_BOT_TOKEN in the server process environment, never in
# this file or the config-root .env. It must be an active, dedicated Bot Token.
# Replace these example client values with the exact values from ChatGPT's
# connection management page before enabling the gateway.
[chatgpt_oauth]
enabled = false
client_id = "https://chatgpt.com/oauth/client.json"
redirect_uri = "https://chatgpt.com/connector_platform_oauth_redirect"
allowed_origins = ["https://chatgpt.com"]

[network]
max_connections = 256
room_participant_limit = 32
code_lookup_per_minute = 20
participant_creation_per_minute = 10
admin_login_failures_per_15_minutes = 5
agent_auth_failures_per_minute = 20
max_compat_matches = 32
max_ranked_queue = 128
trusted_proxy_cidrs = []

[characters]
# These packs must exist under character-packs/ and use matching manifest usage.
mjai = "mjai-bot"
builtin = "tsumogiri-bot"
mcp = "mcp-agent"

[characters.mcp_providers]

[time_controls.casual]
turn_seconds = 30
response_seconds = 10
