# Copy this file to config.toml beside the driichi executable.
# The config file's parent is the runtime data root.
bind = "127.0.0.1:3000"
public_origin = "http://127.0.0.1:3000"
unlimited_watchdog_seconds = 300
empty_room_cleanup_seconds = 3600
shutdown_seconds = 10

[network]
max_connections = 256
room_participant_limit = 32
code_lookup_per_minute = 20
participant_creation_per_minute = 10
admin_login_failures_per_15_minutes = 5
agent_auth_failures_per_minute = 20
trusted_proxy_cidrs = []

[characters]
# These packs must exist under character-packs/ and use matching manifest usage.
mjai = "mjai-bot"
builtin = "tsumogiri-bot"
mcp = "mcp-agent"

[characters.mcp_providers]

[time_controls.casual]
turn_seconds = 30
response_seconds = 10
