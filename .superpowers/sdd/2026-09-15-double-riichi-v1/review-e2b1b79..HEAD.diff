+                } else if uri == Self::uri(&entry.room_code, "", "history") {
+                    self.read_history(&entry, &uri)
+                        .await
+                        .map_err(|error| error.error_data())?
+                } else {
+                    return Err(ErrorData::resource_not_found(uri, None));
+                };
