+}
+
+impl BoundedSessionManager {
+    fn new(inner: Arc<LocalSessionManager>, registry: Arc<McpSessionRegistry>) -> Self {
+        Self {
+            inner,
+            registry,
+            reservations: Arc::new(tokio::sync::Mutex::new(HashMap::new())),
