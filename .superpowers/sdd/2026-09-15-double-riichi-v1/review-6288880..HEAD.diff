+    fn queued_bot(ticket: u64) -> QueuedBot {
+        let (assignment, _receiver) = oneshot::channel();
+        QueuedBot {
+            ticket,
+            token: BotTokenRecord::new(
+                format!("token-{ticket}"),
+                format!("Bot {ticket}"),
+                [ticket as u8; 32],
+                TokenState::Active,
+                0,
+                None,
+            ),
+            display_name: format!("Bot {ticket}"),
